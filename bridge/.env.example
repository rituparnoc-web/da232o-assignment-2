# Copy this file to bridge/.env and fill in real values. NEVER commit .env.

# Backend C - Google AI Studio key
GEMINI_API_KEY=your-gemini-key-here

# Optional alternative cloud backend
GROQ_API_KEY=your-groq-key-here

# Backend B - printed by the Kaggle notebook each session (changes every time)
KAGGLE_TUNNEL_URL=https://example-words-here.trycloudflare.com

# Optional: override config.yaml's active_backend without editing it
# VLM_BACKEND=kaggle
